---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3" | "compact";
} & CollectionEntry<"posts">;

const { variant: variantType = "h2", id, data, filePath } = Astro.props;

const { title, description, ...props } = data;
const url = getPostUrl(id, filePath, Astro.currentLocale);
---

{
  variantType === "compact" ? (
    <li class="my-1">
      <span class="text-muted-foreground inline-block w-16 font-mono text-sm">
        {String(data.pubDatetime.getMonth() + 1).padStart(2, "0")}-{String(data.pubDatetime.getDate()).padStart(2, "0")}
      </span>
      <a
        href={url}
        class="text-foreground hover:text-accent decoration-dashed underline-offset-4 hover:underline"
      >
        {title}
      </a>
    </li>
  ) : (
    <li class="my-6">
      <a
        href={url}
        class:list={[
          "text-accent inline-block text-lg font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        {
          variantType === "h3" ? (
            <h3 transition:name={slugifyStr(title.replaceAll(".", "-"))}>
              {title}
            </h3>
          ) : (
            <h2 transition:name={slugifyStr(title.replaceAll(".", "-"))}>
              {title}
            </h2>
          )
        }
      </a>
      <Datetime {...props} />
      <p>{description}</p>
    </li>
  )
}