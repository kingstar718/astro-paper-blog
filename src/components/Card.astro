---
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { slugifyStr } from "@/utils/slugify";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
  class?: string;
} & CollectionEntry<"posts">;

const {
  variant: variantType = "h2",
  id,
  data,
  filePath,
  class: className,
} = Astro.props;

const { title, description, ...props } = data;
const url = getPostUrl(id, filePath, Astro.currentLocale);
---

<li class:list={["my-4", className]}>
  <div class="flex items-baseline justify-between gap-4">
    <a
      href={url}
      class:list={[
        "text-accent text-lg font-medium",
        "decoration-dashed underline-offset-4 hover:underline",
        "focus-visible:no-underline focus-visible:underline-offset-0",
      ]}
    >
      {
        variantType === "h3" ? (
          <h3 transition:name={slugifyStr(title.replaceAll(".", "-"))}>
            {title}
          </h3>
        ) : (
          <h2 transition:name={slugifyStr(title.replaceAll(".", "-"))}>
            {title}
          </h2>
        )
      }
    </a>
    <Datetime {...props} icon={false} class="shrink-0" />
  </div>
  <p class="mt-1">{description}</p>
</li>
