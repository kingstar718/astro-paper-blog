---
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
// dayjs 的 locale 需要静态引入才会注册；"en" 是内置的，无需 import。
// 语言名由 i18n 的 dateLocale 决定，这里只负责把用到的包挂上。
import "dayjs/locale/zh-cn";
import { useTranslations } from "@/i18n";
import config from "@/config";
dayjs.extend(utc);
dayjs.extend(timezone);

// 全站唯一的日期格式：精确到分钟。时间线和文章详情页共用，两处粒度保持一致。
const DATE_FORMAT = "YYYY-MM-DD HH:mm";

type Props = {
  class?: string;
  size?: "sm" | "lg";
  /** 内容的唯一日期字段；发布与后续修改都更新它 */
  pubDatetime: string | Date;
};

const { pubDatetime, size = "sm", class: className = "" } = Astro.props;

const t = useTranslations(Astro.currentLocale ?? config.site.lang);

// 时区统一取站点配置，不支持按篇覆盖
const datetime = dayjs(pubDatetime).tz(config.site.timezone);

const date = datetime.locale(t.dateLocale).format(DATE_FORMAT);
---

{/* faint 而不是 muted-foreground：日期是索引信息，在标题、简介之后 */}
<div class:list={["text-faint flex items-center", className]}>
  <time
    class:list={["text-sm", { "sm:text-base": size === "lg" }]}
    datetime={datetime.toISOString()}
  >
    {date}
  </time>
</div>
