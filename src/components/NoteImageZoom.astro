---
// 短文缩略图的展开/收起。放在渲染短文的页面上（首页、短文列表页）。
//
// 就地展开，不做弹层：短文本身是内联在时间线里的，弹一个覆盖全屏的层
// 打断感太强；点开原地变大、再点收回，跟阅读的节奏一致。
//
// 尺寸全部交给 CSS（见 typography.css 的 .note-thumbs），脚本只切一个类。
// 展开后元素变宽，浏览器会自己从 srcset 里换更大的一档，不用手动挑。
//
// 渐进增强：脚本没跑，缩略图照常显示，只是点不开。
---

<script is:inline data-astro-rerun>
  (() => {
    const stateKey = "__astroPaperNoteImageZoom";
    if (window[stateKey]) return;
    window[stateKey] = true;

    // 委托挂在 document 上：短文是分页渲染的，逐图绑定既啰嗦，
    // 客户端路由切页后还要重绑。
    document.addEventListener("click", event => {
      const image = event.target.closest(".note-thumbs img");
      if (image) image.classList.toggle("is-expanded");
    });
  })();
</script>
