---
// 短文缩略图的点击放大。放在渲染短文的页面上（首页、短文列表页）。
//
// 脚本不需要知道图片的最终地址：Astro 会把 markdown 里的相对路径编译成
// 带 hash 的 srcset，运行时从中取最大的一档。
// （零 JS 的做法试过：markdown 里 [![](图)](图) 的 a[href] 不会被 Astro 处理，
// 产物里仍是相对路径，点开就是 404。）
//
// 渐进增强：脚本没跑，缩略图照常显示，只是点不开。
---

{
  /* 铺满视口再把图居中：dialog 默认按内容尺寸摆放，会贴在左上角；
    铺满之后点击任意处都能关掉，不必精确点到图外面 */
}
<dialog
  id="note-lightbox"
  class="bg-background/95 fixed inset-0 m-0 h-full max-h-none w-full max-w-none place-items-center p-0 backdrop:bg-transparent open:grid"
  aria-label="图片预览"
>
  <img alt="" class="max-h-[92vh] max-w-[92vw] object-contain" />
</dialog>

<script is:inline data-astro-rerun>
  (() => {
    const stateKey = "__astroPaperLightbox";
    if (window[stateKey]) return;
    window[stateKey] = true;

    // 事件委托挂在 document 上：短文是分页渲染的，逐图绑定既啰嗦又要在
    // 客户端路由切页后重绑，委托一次就够。
    document.addEventListener("click", event => {
      const dialog = document.getElementById("note-lightbox");
      if (!dialog) return;

      if (dialog.open) {
        dialog.close();
        return;
      }

      const image = event.target.closest(".note-thumbs img");
      if (!image) return;

      // 取 srcset 里最大的一档，而不是 currentSrc。
      // currentSrc 是浏览器按缩略图尺寸挑的（112px 的格子往往只挑到中间档），
      // 放大后会发虚；弹层要的是原始尺寸那张。
      const widest = (image.getAttribute("srcset") || "")
        .split(",")
        .map(part => part.trim().split(/\s+/))
        .filter(([url, descriptor]) => url && /^\d+w$/.test(descriptor || ""))
        .sort((a, b) => parseInt(a[1]) - parseInt(b[1]))
        .pop();

      dialog.querySelector("img").src = widest
        ? widest[0]
        : image.currentSrc || image.src;
      dialog.showModal();
    });
  })();
</script>
