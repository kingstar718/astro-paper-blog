---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import DisclosureMarker from "./DisclosureMarker.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

// 文末的更新记录。数据来自 frontmatter 的 updates（见 src/content.config.ts），
// 不写在正文里，因此排版不受 prose 影响，也不会被 pagefind 当正文索引。
type Props = {
  updates: NonNullable<CollectionEntry<"posts">["data"]["updates"]>;
};

const { updates } = Astro.props;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);

// 与页面其他日期同一个格式和时区，全站只有这一种写法
const format = (value: Date) =>
  dayjs(value).tz(config.site.timezone).format("YYYY-MM-DD HH:mm");

const label = `${t.post.updates.title}(${updates.length})`;
const panelId = "post-updates-panel";
---

{
  /*
  没用 <details>：它的按钮和面板必须是父子，塞进元信息行后，
  面板要整行展开就得让整个 <details> 变成整行宽，按钮会跟着换行掉到第二行。
  拆成按钮 + 面板两个兄弟元素，外层 display:contents 让它们各自成为
  meta-row 的 flex 项：按钮留在行里不动，面板 order-1 + w-full 另起一整行。
  （contents 只能用在这种普通容器上，用在 <details> 上会让收起态的面板
  仍然参与布局。）
*/
}
<div class="contents" data-pagefind-ignore>
  <button
    type="button"
    class="text-muted-foreground hover:text-foreground focus-visible:outline-accent group flex cursor-pointer items-center gap-1.5 text-sm transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dashed"
    data-disclosure
    aria-expanded="false"
    aria-controls={panelId}
  >
    <DisclosureMarker />
    {label}
  </button>

  {/* 竖线呼应站点的时间线；每条内部竖向堆叠，窄屏不会被挤成表格那样 */}
  <ol
    id={panelId}
    hidden
    class="border-border order-1 mt-1 w-full space-y-5 border-s ps-3 text-sm"
  >
    {
      updates.map(update => (
        <li>
          <div class="text-muted-foreground flex flex-wrap items-baseline gap-x-2.5">
            <time class="tabular-nums" datetime={update.datetime.toISOString()}>
              {format(update.datetime)}
            </time>
            <span class="text-accent">{update.action}</span>
          </div>
          <p class="text-foreground mt-1 leading-relaxed">{update.note}</p>
          <p class="text-muted-foreground mt-1 text-xs">{update.agent}</p>
        </li>
      ))
    }
  </ol>
</div>
