---
import type { CollectionEntry } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import DisclosureMarker from "./DisclosureMarker.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

// 文末的更新记录。数据来自 frontmatter 的 updates（见 src/content.config.ts），
// 不写在正文里，因此排版不受 prose 影响，也不会被 pagefind 当正文索引。
type Props = {
  updates: NonNullable<CollectionEntry<"posts">["data"]["updates"]>;
};

const { updates } = Astro.props;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);

// 与页面其他日期同一个格式和时区，全站只有这一种写法
const format = (value: Date) =>
  dayjs(value).tz(config.site.timezone).format("YYYY-MM-DD HH:mm");
---

<details class="group mt-16 text-sm" data-pagefind-ignore>
  {/* list-none 去掉浏览器默认的三角，webkit 要额外关掉自己那个伪元素 */}
  <summary
    class="text-muted-foreground hover:text-foreground focus-visible:outline-accent flex w-fit cursor-pointer list-none items-center gap-1.5 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-dashed [&::-webkit-details-marker]:hidden"
  >
    <DisclosureMarker />
    {t.post.updates.title}（{updates.length}
    {t.post.updates.unit}）
  </summary>

  {/* 竖线呼应站点的时间线；每条内部竖向堆叠，窄屏不会被挤成表格那样 */}
  <ol class="border-border ms-1 mt-4 space-y-5 border-s ps-5">
    {
      updates.map(update => (
        <li>
          <div class="text-muted-foreground flex flex-wrap items-baseline gap-x-2.5">
            <time class="tabular-nums" datetime={update.datetime.toISOString()}>
              {format(update.datetime)}
            </time>
            <span class="text-accent">{update.action}</span>
          </div>
          <p class="text-foreground mt-1 leading-relaxed">{update.note}</p>
          <p class="text-muted-foreground mt-1 text-xs">{update.agent}</p>
        </li>
      ))
    }
  </ol>
</details>
