---
import Datetime from "./Datetime.astro";

// 时间线上的一条：圆点 + 时间（+ 可选类型标签），正文由 slot 提供。
// 文章用实心点、短文用空心点，首页混排时靠这个区分。
type Props = {
  kind: "post" | "note";
  pubDatetime: Date | string;
  modDatetime?: Date | string | null;
  timezone?: string;
  /** 类型标签，仅在文章短文混排时需要 */
  label?: string;
};

const { kind, pubDatetime, modDatetime, timezone, label } = Astro.props;
---

<article class="relative pb-6 last:pb-0">
  {/* 圆点与竖线同轴：左移 = 容器内边距 + 边框宽度的一半 + 圆点半径 */}
  <span
    aria-hidden="true"
    class:list={[
      "absolute start-[calc(-1.5rem-5px)] top-[6px] size-2 rounded-full",
      kind === "post" ? "bg-accent" : "border-accent bg-background border-2",
    ]}></span>
  <div class="text-muted-foreground flex items-baseline gap-2 text-sm">
    <Datetime
      pubDatetime={pubDatetime}
      modDatetime={modDatetime}
      timezone={timezone}
      dateFormat="YYYY-MM-DD HH:mm:ss ddd"
      class="tabular-nums"
    />
    {
      label && (
        <>
          <span aria-hidden="true">·</span>
          <span>{label}</span>
        </>
      )
    }
  </div>
  <slot />
</article>
