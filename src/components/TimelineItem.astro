---
import Datetime from "./Datetime.astro";

// 时间线上的一条：圆点 + 时间，正文由 slot 提供。
// 文章用实心点、短文用空心点，首页混排时只靠这个区分，不再标注类型。
type Props = {
  kind: "post" | "note";
  pubDatetime: Date | string;
};

const { kind, pubDatetime } = Astro.props;
---

<article class="relative pb-6 last:pb-0">
  {
    /* 圆点与竖线同轴：左移 = 容器内边距(26) − 竖线半宽(1) + 圆点半径(4) = 29px */
  }
  <span
    aria-hidden="true"
    class:list={[
      "absolute start-[calc(-1.5rem-5px)] top-[6px] size-2 rounded-full",
      kind === "post" ? "bg-accent" : "border-accent bg-background border-2",
    ]}></span>
  <Datetime pubDatetime={pubDatetime} class="tabular-nums" />
  <slot />
</article>
