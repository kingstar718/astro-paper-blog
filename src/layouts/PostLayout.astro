---
import Layout from "./Layout.astro";
import config from "@/config";

type Props = {
  title?: string;
  description?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
};

const { site } = config;

const { title, description, canonicalURL, pubDatetime } = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  // 只有一个日期字段，发布与修改共用，因此 datePublished 与 dateModified 同值
  ...(pubDatetime && {
    datePublished: pubDatetime.toISOString(),
    dateModified: pubDatetime.toISOString(),
  }),
  author: [
    {
      "@type": "Person",
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
};
---

<Layout {title} {description} {canonicalURL}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </Fragment>

  <slot />
</Layout>
