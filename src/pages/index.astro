---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Timeline from "@/components/Timeline.astro";
import TimelineItem from "@/components/TimelineItem.astro";
import PostTimelineItem from "@/components/PostTimelineItem.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// 首页文章、短文各取最近 perIndex 条，再合并按时间倒序
const posts = getSortedPosts(await getCollection("posts")).slice(
  0,
  config.posts.perIndex
);

const now = Date.now();
const noteEntries = (await getCollection("notes", ({ data }) => !data.draft))
  .filter(n => n.data.pubDatetime.getTime() <= now)
  .sort((a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime())
  .slice(0, config.notes.perIndex);
const renderedNotes = await Promise.all(
  noteEntries.map(async note => ({
    note,
    Content: (await render(note)).Content,
  }))
);

// 文章 + 短文混排，按发布时间倒序
type TimelineItem =
  | { kind: "post"; date: Date; post: (typeof posts)[number] }
  | {
      kind: "note";
      date: Date;
      note: (typeof renderedNotes)[number]["note"];
      Content: (typeof renderedNotes)[number]["Content"];
    };

const items: TimelineItem[] = [
  ...posts.map(post => ({
    kind: "post" as const,
    date: post.data.pubDatetime,
    post,
  })),
  ...renderedNotes.map(({ note, Content }) => ({
    kind: "note" as const,
    date: note.data.pubDatetime,
    note,
    Content,
  })),
].sort((a, b) => b.date.getTime() - a.date.getTime());
---

<Layout>
  <Header />
  <main id="main-content" class="app-layout">
    <section class="pt-8 pb-6">
      {/* 文章短文混排，只靠实心点/空心点区分 */}
      <Timeline>
        {
          items.map(item =>
            item.kind === "post" ? (
              <PostTimelineItem post={item.post} />
            ) : (
              <TimelineItem
                kind="note"
                pubDatetime={item.note.data.pubDatetime}
              >
                {/* 段落间距收紧，并去掉首尾外边距，避免和条目间距叠加 */}
                <div class="app-prose mt-2 max-w-none [&_p]:my-[0.45em] [&>:first-child]:mt-0 [&>:last-child]:mb-0">
                  <item.Content />
                </div>
              </TimelineItem>
            )
          )
        }
      </Timeline>

      <nav class="mt-8 flex gap-6 text-sm">
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="hover:text-accent">{t.home.allPosts} →</a
        >
        <a
          href={getRelativeLocaleUrl(locale, "notes")}
          class="hover:text-accent">{t.home.allNotes} →</a
        >
      </nav>
    </section>
  </main>
  <Footer />
</Layout>
