---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Timeline from "@/components/Timeline.astro";
import PostTimelineItem from "@/components/PostTimelineItem.astro";
import TimelineStats from "@/components/TimelineStats.astro";
import Pagination from "@/components/Pagination.astro";
import ListFooter from "@/components/ListFooter.astro";
import { postFilter } from "@/utils/postFilter";
import { getPostsByGroupCondition } from "@/utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection("posts"))
    .filter(postFilter)
    .sort(
      (a, b) => b.data.pubDatetime.getTime() - a.data.pubDatetime.getTime()
    );

  // 条目本身已带完整年份，年份只用于页尾统计；统计的是全部文章而非当前页
  const years: [string, number][] = Object.entries(
    getPostsByGroupCondition(posts, post => post.data.pubDatetime.getFullYear())
  )
    .sort(([a], [b]) => Number(b) - Number(a))
    .map(([year, yearPosts]) => [year, yearPosts.length]);

  return paginate(posts, {
    pageSize: config.posts.perPage,
    props: { total: posts.length, years },
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { total, years } = Astro.props as {
  total: number;
  years: [string, number][];
};

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Main class="pt-8">
    {/* 一条时间线通到底，条目与首页同构，从首页点过来视觉不跳变 */}
    <Timeline>
      {page.data.map(post => <PostTimelineItem post={post} />)}
    </Timeline>

    <ListFooter>
      <Pagination page={page} />
      <TimelineStats total={total} unit={t.pages.postsUnit} groups={years} />
    </ListFooter>
  </Main>

  <Footer />
</Layout>
