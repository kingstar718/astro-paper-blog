---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getPostSlug } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { slugifyStr } from "@/utils/slugify";
import TableOfContents from "./_components/TableOfContents.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const t = useTranslations(Astro.currentLocale);

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const sortedPosts = getSortedPosts(posts);

  return sortedPosts.map(post => ({
    params: { slug: getPostSlug(post.id, post.filePath) },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;

const { title, description, canonicalURL, pubDatetime } = post.data;

const { Content, headings } = await render(post);
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
>
  <Header />

  <TableOfContents {headings} />

  <main
    id="main-content"
    class="app-layout mt-8"
    data-pagefind-body
    data-copy-label={t.post.copy}
    data-copied-label={t.post.copied}
  >
    <h1
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      class="inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <Datetime {pubDatetime} size="lg" class="my-2" />

    <TableOfContents {headings} variant="inline" />

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>
  </main>
  <Footer />
</PostLayout>

<script is:inline data-astro-rerun>
  (() => {
    const mainContent = document.getElementById("main-content");
    const copyButtonLabel = mainContent?.dataset.copyLabel ?? "Copy";
    const copiedButtonLabel = mainContent?.dataset.copiedLabel ?? "Copied";
    const stateKey = "__astroPaperPostPage";
    const state = window[stateKey] ?? (window[stateKey] = {});

    async function copyCode(block, button) {
      const code = block.querySelector("code");
      const text = code?.innerText ?? "";

      await navigator.clipboard.writeText(text);

      button.innerText = copiedButtonLabel;
      window.setTimeout(() => {
        button.innerText = copyButtonLabel;
      }, 700);
    }

    function attachCopyButtons() {
      const codeBlocks = document.querySelectorAll("pre");

      for (const codeBlock of codeBlocks) {
        if (codeBlock.querySelector(".copy-code")) {
          continue;
        }

        let wrapper = codeBlock.parentElement;
        if (!wrapper || !wrapper.hasAttribute("data-code-block-wrapper")) {
          wrapper = document.createElement("div");
          wrapper.setAttribute("data-code-block-wrapper", "");
          wrapper.style.position = "relative";
          codeBlock.parentNode?.insertBefore(wrapper, codeBlock);
          wrapper.appendChild(codeBlock);
        }

        const computedStyle = getComputedStyle(codeBlock);
        const hasFileNameOffset =
          computedStyle.getPropertyValue("--file-name-offset").trim() !== "";
        const topClass = hasFileNameOffset
          ? "top-(--file-name-offset)"
          : "-top-3";

        const copyButton = document.createElement("button");
        copyButton.type = "button";
        copyButton.className = `copy-code absolute end-3 ${topClass} rounded bg-muted border border-muted px-2 py-1 text-xs leading-4 text-foreground font-medium`;
        copyButton.innerText = copyButtonLabel;

        codeBlock.setAttribute("tabindex", "0");
        codeBlock.appendChild(copyButton);

        copyButton.addEventListener("click", async () => {
          await copyCode(codeBlock, copyButton);
        });
      }
    }

    function bindAfterSwapScrollReset() {
      if (state.afterSwapHandler) {
        document.removeEventListener(
          "astro:after-swap",
          state.afterSwapHandler
        );
      }

      state.afterSwapHandler = () =>
        window.scrollTo({ left: 0, top: 0, behavior: "instant" });

      document.addEventListener("astro:after-swap", state.afterSwapHandler);
    }

    attachCopyButtons();
    bindAfterSwapScrollReset();
  })();
</script>
